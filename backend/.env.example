PORT=4000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
# set true only if frontend and backend are on different domains (needs HTTPS)
COOKIE_CROSS_SITE=false
JWT_SECRET=change-me-to-a-long-random-string

DATABASE_URL=postgres://postgres:postgres@localhost:5432/scheduler
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Google OAuth (Google Cloud Console > Credentials > OAuth client ID > Web)
# Authorized redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth (api.slack.com/apps > OAuth & Permissions, scope: incoming-webhook)
# Slack needs an HTTPS redirect URL -> use ngrok/cloudflared locally and set it here
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://YOUR-TUNNEL.ngrok-free.app/auth/slack/callback

# --- Throughput / rate limiting (all configurable) ---
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
# window length for the "hourly" limit; keep 3600 in real use, lower it (e.g. 120) to demo
RATE_WINDOW_SECONDS=3600
SENDER_COUNT=3

# run the BullMQ worker inside the API process (set false to run `npm run worker` separately)
RUN_WORKER=true

# optional: basic auth for /admin/queues
BULL_BOARD_USER=
BULL_BOARD_PASS=

# optional dev-only: lets Postman / load-test call the API with header x-api-key
DEV_API_KEY=
